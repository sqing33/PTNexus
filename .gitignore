# Local runtime output (avoid committing dev logs/cache created when running from repo root)
/data/
.parafork/
.worktree-lite/
/webui/dist/
/dist/updates/

# Local env
/server/.env
/server/.env.*
/server-go/.env
/server-go/.env.*

# Runtime data (private)
/server/data/
/server/cmd/server/data/
/server-go/data/
/server-go/cmd/server/data/

# Runtime logs / debug artifacts
/server/migration.log
/server/**/debug_*.log
/server-go/**/debug_*.log
/data/tmp/
/proxy/runtime/

# Proxy local build outputs
/proxy/pt-nexus-box-proxy
/proxy/pt-nexus-box-proxy-amd64
/proxy/pt-nexus-box-proxy-arm64
/proxy/pt-nexus-box-proxy-linux-amd64
/proxy/pt-nexus-box-proxy.exe

# Local IDE/agent private settings
/.claude/settings.local.json
/.claude/worktrees/
/.vscode/*
!/.vscode/extensions.json
*/__pycache__
